<idea-plugin>
    <id>io.github.antomys.azdoprreview</id>
    <name>Azure DevOps PR Review</name>
    <vendor>antomys</vendor>
    <description><![CDATA[
        Review Azure DevOps pull requests in Rider: browse pull requests, read the diff,
        and discuss changes in inline comment threads.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Azure DevOps PR Review" anchor="left" icon="AllIcons.Vcs.Merge"
                    factoryClass="io.github.antomys.azdoprreview.toolwindow.PullRequestToolWindowFactory"/>
        <projectConfigurable id="io.github.antomys.azdoprreview.settings" parentId="tools"
                             displayName="Azure DevOps PR Review"
                             instance="io.github.antomys.azdoprreview.settings.AzureDevOpsConfigurable"/>
    </extensions>
</idea-plugin>
